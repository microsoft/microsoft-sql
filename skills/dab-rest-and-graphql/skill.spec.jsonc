{
  "$schema": "../../catalog/skill.spec.schema.json",
  "id": "dab-rest-and-graphql",
  "domain": "apis-and-application-patterns",
  "value": ["not-in-training-data", "multi-step-with-silent-failures", "corrects-a-wrong-assumption"],
  "correction": "Agents write a Data API builder configuration in its 1.x shape, one hand-authored entity block per table, and reason about it as though an unconfigured role is denied, when version 2.0 changed all three inputs to that judgement: dab init now writes the Unauthenticated provider so every request is evaluated as anonymous, a permission granted to anonymous is inherited upward by authenticated and by every unconfigured named role, and autoentities generate entities from T-SQL LIKE patterns whose default include is every object in every schema. The result is a configuration that starts cleanly, passes dab validate, and publishes more of the database to unauthenticated callers than the author asked for, with nothing in the startup output naming the excess.",
  "posture": ["read", "write", "execute"],
  "maturity": "preview",
  "applies_to": ["azure-sql-db"],
  "related": [
    "azuresql-db-dab",
    "dab-mcp-endpoint",
    "build-app-on-azure-sql",
    "azure-functions-sql-bindings",
    "connect-to-azure-sql",
    "entra-id-auth",
    "deploy-app-to-azure",
    "provision-azure-sql-db",
    "data-api-clients-js-python"
  ],
  "validation": {
    "target": "cloud",
    "setup": [
      "an Azure SQL Database with at least two schemas, one of which holds a table that must not be published",
      "the Data API builder CLI at 2.0 or later, installed as a dotnet tool"
    ],
    "assert": [
      "dab auto-config-simulate is run before dab start, and its match list is compared against the tables the author intended",
      "the include and exclude patterns are T-SQL LIKE, so a pattern written as a regular expression matches nothing or the wrong set",
      "dab configure --show-effective-permissions reports the role that actually reaches each entity after inheritance, not the roles written in the file",
      "a configuration generated by dab init carries provider Unauthenticated, and is changed before the API is reachable from outside the developer machine",
      "the connection string in the deployed configuration carries no password and resolves through an environment variable or a key vault reference"
    ]
  },
  "triggering": {
    "explicit": ["Use the dab-rest-and-graphql skill"],
    "implicit": [
      "expose my Azure SQL tables as a REST API without writing a controller",
      "generate a GraphQL API over my Azure SQL database",
      "set up Data API builder against Azure SQL Database",
      "my dab-config.json has three hundred entities and I cannot maintain it",
      "why can anonymous callers read this entity when I only granted the reader role"
    ],
    "routing": [
      "I need CRUD endpoints over these tables and I do not want to write them",
      "give me an API for this database",
      "how do I add relationships to my Data API builder config",
      "restrict which rows a caller can see in my data API"
    ],
    "negative": [
      "run Data API builder against my local Azure SQL Database container",
      "add a SQL output binding to my Azure Functions app",
      "use the SQL trigger to run code when a row changes in the container",
      "connect the Data API builder MCP endpoint to my agent",
      "scaffold a Next.js app with a database",
      "write an Entity Framework Core model for these tables",
      "reuse one connection pool across my serverless invocations"
    ]
  }
}
