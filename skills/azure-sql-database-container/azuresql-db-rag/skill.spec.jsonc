{
  "$schema": "../../../catalog/skill.spec.schema.json",
  "id": "azuresql-db-rag",
  "domain": "azure-sql-database-container",
  "value": [
    "not-in-training-data"
  ],
  "correction": "For embeddings an agent reaches for pgvector, FAISS, Chroma or Pinecone and adds a second datastore. This engine has a native VECTOR type and VECTOR_DISTANCE, so the vectors live beside the data they belong to. Inserting one requires CAST(CAST(? AS NVARCHAR(MAX)) AS VECTOR(n)) with a literal dimension, which is not guessable.",
  "posture": [
    "read",
    "write",
    "execute"
  ],
  "maturity": "preview",
  "applies_to": [
    "azure-sql-db-container"
  ],
  "last_verified": "2026-08-20",
  "validation": {
    "target": "container",
    "assert": [
      "uses the native VECTOR type rather than an external vector store",
      "vector insert uses the documented cast form"
    ]
  },
  "triggering": {
    "explicit": [
      "Use the azuresql-db-rag skill"
    ],
    "implicit": [
      "store embeddings and do similarity search locally in SQL"
    ],
    "negative": [
      "set up a local PostgreSQL database with docker compose",
      "provision an Azure SQL Database in my subscription",
      "connect to SQL Server on my company network"
    ]
  }
}
