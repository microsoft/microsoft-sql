{
  "$schema": "../../catalog/skill.spec.schema.json",
  "id": "diagnose-connection-errors",
  "domain": "drivers-and-connectivity",
  "value": ["changes-too-fast-to-memorize", "multi-step-with-silent-failures"],
  "correction": "Shown a failed connection to Azure SQL Database, an agent reads every error as a credential or connection-string problem and starts editing the connection string, when the error number already names the layer that rejected it and that layer is usually in front of the login rather than behind it: 40615 is a missing IP firewall rule and 40914 the same refusal from a virtual network rule, neither of which any connection string can fix, 42101 and 47073 mean public network access is turned off, 40532 is the gateway refusing before a database was reached at all and is not the login failure it reads as, 47072 is a TLS version the server will not accept, and a certificate-chain failure is a client trust store problem that trusting the server certificate hides rather than fixes. The failures carrying no SQL number at all are the ones most often given up on as unknown, when their message text is the whole diagnosis.",
  "value_probe": {
    "task": "Our platform team moved one of our services onto new networking last night. Since then every attempt from that service to reach its database in Azure fails. The same code, the same image and the same configuration still work from a developer laptop and from our older environment.\n\nThis is the whole of what the application logs:\n\n```\nA connection was successfully established with the server, but then an error occurred during the pre-login handshake. (provider: TCP Provider, error: 0)\n```\n\nThere is no SQL error number anywhere in it. Our support ticket has been open for a day. In that time we have rotated the database password twice, recreated the application's database user, lengthened the connection timeout, and added and removed several connection string settings. None of it changed the message by a single character.\n\nThe team is now arguing that the message is too generic to work with and we should escalate and wait. Before we do that, tell me what this message is actually telling us and what we should check next.",
    "gate": "The answer reads the message as a failure occurring in front of the login, on the network path or during protocol negotiation, and directs the investigation at the network layer and at what the two ends will negotiate, while stating plainly that no credential change and no connection string edit can affect it.",
    "states": [
      "The failure occurs before any credential is exchanged, so the password, the database user and their permissions cannot be the cause.",
      "The absence of a SQL error number means the connection was terminated by something between or in front of the two endpoints rather than refused by the database engine.",
      "The message identifies a specific stage of the connection and is therefore diagnosable, not a generic unknown fault.",
      "The change in networking is the first thing to examine, since the same code succeeds unchanged from another network."
    ],
    "refutes": [
      "A message of this kind with no error number carries no usable diagnostic information, so the only remaining options are to escalate, wait, or retry indefinitely.",
      "This is a credential or connection string problem, so rotating the password, recreating the database user, or adjusting connection string settings is a reasonable next step.",
      "Lengthening the connection timeout addresses this failure, because the connection is being cut off before it has had time to complete.",
      "The database or the server is unavailable, and the right response is to wait for the service to recover."
    ]
  },
  "posture": ["read", "inspect"],
  // Held at draft below a preview ceiling, on purpose. Re-measured 2026-09-19 at
  // ten runs per arm: UNCLEAR, and nothing moved. The gate and three of the four
  // statements read 10 of 10 with the skill and 10 of 10 without, the fourth 10 of
  // 10 against 8 of 10, and every falsehood 0 of 10 in both arms. The model
  // already answers this skill's own task correctly without it.
  // This is an author declaring below the ceiling, which the ladder permits, and
  // it is not the skill failing. Its engine probes still pass and nothing here is
  // unverified. Do not raise this field to clear the promotion backlog. It moves
  // when the skill is rewritten to say something the model does not already know
  // and a fresh measurement shows lift, and not before.
  "maturity": "draft",
  "applies_to": ["azure-sql-db", "azure-sql-db-container"],
  "related": [
    "connect-to-azure-sql",
    "provision-azure-sql-db",
    "entra-id-auth",
    "diagnose-resource-pressure",
    "private-endpoints-and-firewall"
  ],
  "validation": {
    "target": "both",
    "setup": [
      "a reachable database and a client that can attempt a connection",
      "an attempt from an address that no firewall rule covers",
      "an attempt against a server whose public network access is disabled",
      "a second attempt with a deliberately wrong password",
      "a second attempt naming a database that does not exist"
    ],
    "assert": [
      "an address with no firewall rule returns 40615 and the skill answers with a firewall rule rather than an edit to the connection string, and accounts for the five minute propagation delay",
      "a server with public network access disabled returns 47073 and is not diagnosed as a credential problem. Measured 2026-09-08 on sqllab0908614: the refusal is immediate rather than a timeout, and go-sqlcmd 1.10.0 prints the severity 10 sub-message text in full while printing no number",
      "an error carrying no SQL number is classified from its message text rather than reported as unknown",
      "a certificate-chain failure is answered by fixing the client trust store, never by trusting the server certificate",
      "a wrong password returns 18456, and the skill names the layer that rejected it and hands it to entra-id-auth rather than answering it here or blaming the firewall",
      "a database name that does not exist returns 4060, and is likewise named and handed on rather than answered as a firewall or connection-string fault",
      "40613 is named as expected serverless resume and handed to connect-to-azure-sql rather than answered here",
      "a refusal that arrives with no visible number is not declared unknown before -m-1 has been tried, because 47072, 47073 and 42101 are severity 10 and are converted to severity 0 before the client sees them. The TEXT still reaches the client on go-sqlcmd 1.10.0, measured 2026-09-08, so the reason is readable even where the number is not"
    ],
    "probes": [
      {
        "sql": "SELECT message_id, severity\nFROM sys.messages\nWHERE language_id = 1033 AND message_id IN (4060, 18456)\nORDER BY message_id;",
        "expect": {
          "rows": [
            [4060, 11],
            [18456, 14]
          ]
        },
        "why": "The skill's central move made executable: a number can be resolved to its severity on the engine itself rather than from memory, and the severity is what names the layer. Microsoft Learn's error number tables give 4060 severity 11, which its severity definitions define as 'the given object or entity does not exist', and 18456 severity 14, 'security'. That pair is exactly the distinction the body draws between a missing database user and a refused credential. Both numbers are core Database Engine messages present on every SQL Server engine, so this is safe on the container as well as the cloud. A red here means either the engine's message catalog moved or language_id 1033 is not installed, and the body's severity table would need re-sourcing."
      },
      {
        "sql": "RAISERROR (N'probe: a severity ten message does not fail the statement', 10, 1) WITH NOWAIT;",
        "expect": {
          "warning": 50000
        },
        "why": "Half of the reason this skill tells readers to run sqlcmd with -m-1. Microsoft Learn states that RAISERROR with a message string and no msg_id raises error number 50000, and that a severity of 10 or lower does not transfer control to a CATCH block. So this statement SUCCEEDS while emitting a numbered message, which is only visible because the runner passes -m-1. Not measured against a container by this skill's author, who was instructed not to start one; it is asserted from Learn and from the lane's own -m-1 behaviour, which eval/lib/container.mjs documents. This is the same class 47072, 47073 and 42101 belong to, and the reason a disabled public network access so often reaches a developer as an unexplained timeout."
      },
      {
        "sql": "RAISERROR (N'probe: a severity eleven message fails the statement', 11, 1);",
        "expect": {
          "error": 50000
        },
        "why": "The other half, and the pair is the point. Identical statement, severity raised by one, and now it is an error rather than a warning. That is the exact threshold sqlcmd's -b uses: it sets a non-zero exit at severity 11 and above and stays silent below it, which is why -b alone will not fail a pipeline on the severity 10 refusals above. Severity 11 is also the level 40532, 40531 and 4060 carry, so this probe fails the way the skill's own subject matter fails."
      },
      {
        "cmd": "sqlcmd '-?' | grep -q '^-b,--exit-on-error$' && sqlcmd '-?' | grep -q '^-m,--error-level$' && sqlcmd '-?' | grep -q '^-l,--login-timeOut$'",
        "where": "host",
        "expect": {
          "succeeds": true
        },
        "why": "Every diagnosis command in this body is sqlcmd -b -m-1 -l 30, and each of those three switches is checked to exist under that exact name in the build's own help output rather than from memory. Measured 2026-09-03 on sqlcmd 1.10.0, exit 0. Host rather than container deliberately: the reader of this skill is a developer connecting FROM their workstation into Azure SQL Database, and the client half is the half that has to be right. A red here means the body hands the reader a flag that no longer exists."
      },
      {
        "cmd": "az sql server firewall-rule list --help > /dev/null",
        "where": "host",
        "expect": {
          "succeeds": true
        },
        "why": "The command the body tells a reader to run first when they see 40615, checked against the installed CLI rather than recalled. Measured 2026-09-03 on Azure CLI 2.90.0, exit 0. --help is used deliberately so the probe proves the command surface exists without touching a subscription or creating anything. This matters here because a sibling skill's brief records az sql server update --assign-identity as a flag that does not exist on this same CLI version, so a command name from memory is not evidence."
      },
      {
        "cmd": "az sql server update --help | grep -q -- '--set'",
        "where": "host",
        "expect": {
          "succeeds": true
        },
        "why": "Microsoft Learn's connectivity settings page changes public network access with az sql server update --set publicNetworkAccess=\"Disabled\", a generic-update form rather than a dedicated flag, and the body reads the same property back with az sql server show --query. This checks that --set is still the shape this CLI offers. Measured 2026-09-03 on Azure CLI 2.90.0, exit 0."
      }
    ]
  },
  "triggering": {
    "explicit": [
      "Use the diagnose-connection-errors skill on this stack trace"
    ],
    "implicit": [
      "Cannot open server requested by the login. Client with IP address is not allowed to access the server",
      "The certificate chain was issued by an authority that is not trusted",
      "A connection was successfully established with the server, but then an error occurred during the pre-login handshake",
      "we turned off public network access and now every connection fails with 47073, what is that",
      "the gateway returned 40532 and the server name looks right to me",
      "the connection just times out and there is no error number anywhere, what do I even look at"
    ],
    "routing": [
      "why can my database not be reached",
      "the connection worked yesterday and fails today",
      "my app connects fine on my laptop but gets a timeout once it is deployed"
    ],
    "negative": [
      "Database on server is not currently available. Please retry the connection later",
      "my first connection to the serverless database fails and the second one works, what should I add",
      "Login failed for user, what do I do",
      "Cannot open database requested by the login. The login failed",
      "write the retry policy for my data access layer",
      "which driver should I use from Python",
      "my query is slow, find out why",
      "create a firewall rule for a new database I am provisioning"
    ]
  }
}
