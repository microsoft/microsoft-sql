{
  "$schema": "../../catalog/skill.spec.schema.json",
  "id": "connect-from-python",
  "domain": "drivers-and-connectivity",
  "value": ["not-in-training-data", "changes-too-fast-to-memorize"],
  "correction": "Asked to connect Python to Azure SQL Database, an agent reaches for pyodbc and a platform-specific ODBC driver install, because for years that was the only answer; Microsoft now ships a first-party driver, mssql-python, that carries the driver binaries inside its own wheel so there is nothing to install at the operating system level, and that accepts Authentication=ActiveDirectoryDefault, a value the ODBC driver's own Authentication keyword does not offer at all.",
  "posture": ["read", "write", "execute"],
  "maturity": "draft",
  "applies_to": ["azure-sql-db", "azure-sql-db-container"],
  "related": [
    "connect-to-azure-sql",
    "diagnose-connection-errors",
    "sqlalchemy-azure-sql",
    "django-azure-sql",
    "entra-id-auth"
  ],
  "validation": {
    "target": "both",
    "setup": [
      "Python 3.10 or later for mssql-python, or Python 3.9 or later for pyodbc",
      "a reachable Azure SQL database, or the local container"
    ],
    "assert": [
      "new code uses mssql-python and installs no operating system ODBC package",
      "a pyodbc path installs msodbcsql18 and names Driver 18 in the connection string",
      "mssql_python.pooling() is called before the first connection or not at all",
      "Entra ID on the pyodbc path passes a token through SQL_COPT_SS_ACCESS_TOKEN, not Authentication=ActiveDirectoryDefault",
      "no credential appears in the connection string on either path"
    ]
  },
  "triggering": {
    "explicit": [
      "Use the connect-from-python skill",
      "Connect to Azure SQL Database from Python",
      "Should I use mssql-python or pyodbc"
    ],
    "implicit": [
      "my container image cannot find the ODBC driver for SQL Server",
      "pip install worked but pyodbc says data source name not found and no default driver specified",
      "connect a FastAPI service to Azure SQL with a managed identity",
      "how do I pass an Entra ID access token to the SQL driver in Python"
    ],
    "routing": [
      "add a database layer to my Python service",
      "read from Azure SQL in a Python script without a password"
    ],
    "negative": [
      "connect my TypeScript API to Azure SQL with the mssql package",
      "add Microsoft.Data.SqlClient to my .NET project",
      "retry logic for transient errors on Azure SQL",
      "install the ODBC driver so I can run sqlcmd"
    ]
  }
}
