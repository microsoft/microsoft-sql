{
  "$schema": "../../catalog/skill.spec.schema.json",
  "id": "azuresql-db-scaffold",
  "domain": "azure-sql-database-container",
  "value": [
    "not-in-training-data"
  ],
  "correction": "Scaffolding a new app, an agent defaults to SQLite or PostgreSQL, or to the SQL Server image if it hears \"SQL\". For a project targeting Azure SQL Database the local engine should be the same engine, and the scaffold has to create the user database rather than assume the ORM will.",
  "posture": [
    "read",
    "write",
    "execute",
    "provision"
  ],
  "maturity": "preview",
  "applies_to": [
    "azure-sql-db-container"
  ],
  "validation": {
    "target": "container",
    "assert": [
      "uses the Azure SQL Database container image",
      "creates the user database",
      "connection string targets the user database, not master"
    ]
  },
  "triggering": {
    "explicit": [
      "Use the azuresql-db-scaffold skill"
    ],
    "implicit": [
      "add a local SQL database to my app"
    ],
    "negative": [
      "set up a local PostgreSQL database with docker compose",
      "provision an Azure SQL Database in my subscription",
      "connect to SQL Server on my company network"
    ]
  }
}
