{
  "$schema": "../../catalog/skill.spec.schema.json",
  "id": "skill-feedback",
  "domain": "docs-and-feedback",
  "value": ["not-in-training-data"],
  "correction": "Agents asked to report a problem with a skill compose a generic bug report from whatever is already sitting in the conversation, including connection strings, tokens and server names, when this catalog's issue form expects an exact set of field ids with every credential removed first, so an unredacted report leaks a secret publicly, or a malformed one lands with the fields maintainers actually rely on left blank or wrongly guessed.",
  "posture": ["read"],
  "maturity": "draft",
  "applies_to": ["azure-sql-db", "azure-sql-db-container"],
  "related": ["azure-sql"],
  "validation": {
    "target": "none",
    "setup": [
      "no infrastructure. Every field id, dropdown value and label is checked against the repository's own issue template and against scripts/check-prefill-contract.mjs, never against a live engine"
    ],
    "assert": [
      "the emitted URL uses exactly the field ids skill, problem-type, agent, install-method, what-happened, skill-said, repro, additional, and never a renamed or invented one",
      "the labels parameter carries the full set skills,needs-triage,via-skill rather than only via-skill",
      "no field value contains a password, a connection-string secret, a bearer token, a subscription id, a tenant id, or a real email address",
      "a skill id that is not one of the dropdown's verbatim options is reported as Not sure or The collection as a whole, never invented or fuzzy-matched",
      "the issue is never opened or submitted without the user's explicit confirmation of the full title and body",
      "the prefilled link uses the full github.com URL, never an aka.ms short link"
    ]
  },
  "triggering": {
    "explicit": [
      "File a bug that the diagnose-connection-errors skill gave me the wrong fix",
      "Open a GitHub issue about this skill collection, install never picked anything up",
      "The skill-feedback skill itself is broken, report it"
    ],
    "implicit": [
      "I followed the skill exactly and it still told me to do the wrong thing, someone building this should know",
      "This skill's description says it covers this, but it never fired when I asked for it",
      "No skill loaded for this at all, and one clearly should have"
    ],
    "negative": [
      "My connection to Azure SQL Database keeps timing out, help me fix it",
      "The schema migration failed halfway through, what do I do",
      "My query is slow, find out why",
      "This skill worked perfectly, thanks"
    ]
  }
}
